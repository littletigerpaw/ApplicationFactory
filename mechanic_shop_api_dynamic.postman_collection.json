  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create customer status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Customer response includes id and email', function () {",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json).to.have.property('email');",
                  "});",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('customerId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tyler Customer\",\n  \"email\": \"tyler.customer@example.com\",\n  \"password\": \"Password123!\",\n  \"phone\": \"555-111-2222\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                ""
              ]
            }
          }
        },
