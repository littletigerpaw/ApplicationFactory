                  "});",
                  "const json = pm.response.json();",
                  "const removedId = Number(pm.collectionVariables.get('mechanicId'));",
                  "pm.test('Mechanic no longer on ticket', function () {",
                  "  const ids = (json.mechanics || []).map(function (m) { return m.id; });",
                  "  pm.expect(ids).to.not.include(removedId);",
                  "});"
                ]
