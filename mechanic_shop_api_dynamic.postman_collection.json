        {
          "name": "Assign Mechanic To Ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Assign mechanic status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "const assignedId = Number(pm.collectionVariables.get('mechanicId'));",
                  "pm.test('Mechanic appears on ticket', function () {",
                  "  const ids = (json.mechanics || []).map(function (m) { return m.id; });",
                  "  pm.expect(ids).to.include(assignedId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/service-tickets/{{ticketId}}/assign-mechanic/{{mechanicId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "service-tickets",
                "{{ticketId}}",
                "assign-mechanic",
                "{{mechanicId}}"
              ]
            }
