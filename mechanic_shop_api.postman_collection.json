  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tyler Customer\",\n  \"email\": \"tyler.customer@example.com\",\n  \"password\": \"Password123!\",\n  \"phone\": \"555-111-2222\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                ""
              ]
            }
          }
        },
        {
          "name": "Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('customerToken', json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tyler.customer@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "login"
              ]
            }
          }
        }
      ]
    },
